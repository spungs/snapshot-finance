generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  name                  String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  emailVerified         DateTime?
  image                 String?
  isAutoSnapshotEnabled Boolean             @default(false)
  cashBalance           Decimal             @default(0) @db.Decimal(15, 2)
  cashAccounts          Json?
  targetAsset           Decimal             @default(0) @db.Decimal(15, 2)
  role                  String              @default("user")
  agreedAt              DateTime?
  accounts              Account[]
  brokerageAccounts     BrokerageAccount[]
  holdings              Holding[]
  snapshots             PortfolioSnapshot[]
  subscription          Subscription?
  payments              Payment[]
  usageCounters         UsageCounter[]
  deletedAt             DateTime?
  grantedAccess         PortfolioAccess[]   @relation("AccessOwner")   // 내가 남에게 위임한 것
  receivedAccess        PortfolioAccess[]   @relation("AccessGrantee") // 남이 나에게 위임한 것

  @@map("users")
}

// 포트폴리오 위임 접근 — owner 의 포트폴리오를 grantee 가 대리 CRUD 할 수 있게 하는 grant.
// 연결/철회는 스키마가 아니라 이 테이블의 행(row) 삽입/삭제로 표현한다(재배포 불필요).
// 지금은 나→여자친구 단방향 editor 한 건만 쓰지만, role 로 향후 viewer 확장 여지를 둔다.
model PortfolioAccess {
  id        String   @id @default(cuid())
  ownerId   String   // 포트폴리오 주인 (데이터 소유자)
  granteeId String   // 관리 권한을 받는 사람
  role      String   @default("editor") // 'editor' | (향후) 'viewer'
  createdAt DateTime @default(now())
  owner     User     @relation("AccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grantee   User     @relation("AccessGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@unique([ownerId, granteeId])
  @@index([granteeId])
  @@map("portfolio_access")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PortfolioSnapshot {
  id           String            @id @default(cuid())
  snapshotDate DateTime          @default(now()) @db.Timestamptz(6)
  totalValue   Decimal           @db.Decimal(15, 2)
  totalCost    Decimal           @db.Decimal(15, 2)
  totalProfit  Decimal           @db.Decimal(15, 2)
  profitRate   Decimal           @db.Decimal(10, 4)
  cashBalance  Decimal           @db.Decimal(15, 2)
  cashAccounts Json?
  note         String?
  createdAt    DateTime          @default(now())
  exchangeRate Decimal           @default(1435) @db.Decimal(10, 2)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings     SnapshotHolding[]

  @@index([userId, snapshotDate(sort: Desc)])
  @@index([snapshotDate(sort: Desc)])
  @@map("portfolio_snapshots")
}

model SnapshotHolding {
  id           String            @id @default(cuid())
  snapshotId   String
  stockCode    String
  quantity     Int
  averagePrice Decimal           @db.Decimal(15, 2)
  currentPrice Decimal           @db.Decimal(15, 2)
  totalCost    Decimal           @db.Decimal(15, 2)
  currentValue Decimal           @db.Decimal(15, 2)
  profit       Decimal           @db.Decimal(15, 2)
  profitRate   Decimal           @db.Decimal(10, 4)
  createdAt    DateTime          @default(now())
  currency     String            @default("KRW")
  purchaseRate Decimal           @default(1) @db.Decimal(10, 2)
  snapshot     PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  stock        Stock             @relation(fields: [stockCode], references: [stockCode])

  @@index([snapshotId])
  @@index([stockCode])
  @@map("snapshot_holdings")
}

// 통합된 종목 마스터 (구 kis_stock_masters + 구 stocks 가 합쳐짐).
// KIS 마스터에서 정기 동기화되며, holdings/snapshot_holdings 가 stockCode 로 직접 참조한다.
model Stock {
  stockCode String   @id        // ticker — KIS 마스터의 row 가 그대로 들어옴
  nameKo    String              // 한글 표시명 (구 KIS stockName)
  nameEn    String?             // 풀네임 영문명 (구 KIS engName)
  market    String              // KOSPI | KOSDAQ | NASD | NYSE | AMEX
  updatedAt DateTime @updatedAt

  liveHoldings Holding[]
  holdings     SnapshotHolding[]

  @@index([nameKo])
  @@index([nameEn])
  @@map("stocks")
}

model BrokerageAccount {
  id           String    @id @default(cuid())
  userId       String
  name         String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings     Holding[]

  @@index([userId])
  @@map("brokerage_accounts")
}

model Holding {
  id             String           @id @default(cuid())
  userId         String
  accountId      String
  stockCode      String
  quantity       Int
  averagePrice   Decimal          @db.Decimal(15, 2)
  currentPrice   Decimal          @default(0) @db.Decimal(15, 2)
  currency       String           @default("KRW")
  purchaseRate   Decimal          @default(1) @db.Decimal(10, 2)
  priceUpdatedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  stock          Stock            @relation(fields: [stockCode], references: [stockCode])
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        BrokerageAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, stockCode])
  @@index([userId])
  @@index([accountId])
  @@index([stockCode])
  @@map("holdings")
}

model ApiToken {
  id        String   @id @default(cuid())
  provider  String   @unique
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api_tokens")
}

// (구 KisStockMaster 모델 제거 — Stock 모델로 통합됨)

model KisMasterSyncLog {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt   DateTime? @db.Timestamptz(6)
  status       String    // 'running' | 'success' | 'failed' | 'aborted'
  rowCounts    Json?     // { KOSPI: 2523, KOSDAQ: 1823, NASD: 4967, ... }
  errorMessage String?   @db.Text
  triggeredBy  String    // 'github-actions' | 'manual'

  @@index([startedAt])
  @@index([status])
  @@map("kis_master_sync_logs")
}

model CronLog {
  id        String   @id @default(cuid())
  jobName   String
  status    String   // 'SUCCESS', 'FAILED', 'PARTIAL'
  message   String?  @db.Text
  details   Json?    // Store detailed error objects or stats
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("cron_logs")
}

// 유료 구독 — 사용자당 1개 (FREE/PRO)
model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  plan               String    @default("FREE") // 'FREE' | 'PRO'
  status             String    @default("ACTIVE") // 'ACTIVE' | 'CANCELED' | 'EXPIRED' | 'PAST_DUE'
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  billingKey         String?
  pgProvider         String? // 'PORTONE' | 'TOSS' 등
  canceledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@index([status, currentPeriodEnd]) // 갱신 7일 전 알림 cron 용
  @@map("subscriptions")
}

// 결제 영수증 — PG 트랜잭션 단위, pgTxId 가 멱등키
model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Decimal       @db.Decimal(15, 2)
  currency       String        @default("KRW")
  status         String // 'SUCCEEDED' | 'FAILED' | 'REFUNDED' | 'PENDING'
  pgTxId         String?       @unique // PG 트랜잭션 ID, 멱등키
  pgProvider     String?
  paidAt         DateTime?
  refundedAt     DateTime?
  failureReason  String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, paidAt(sort: Desc)])
  @@index([subscriptionId])
  @@map("payments")
}

// 사용량 카운터 — 일/월 단위 quota 추적
model UsageCounter {
  id          String   @id @default(cuid())
  userId      String
  kind        String // 'AI_DAILY' | 'SIMULATION_MONTHLY' 등
  count       Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodStart])
  @@index([userId, kind])
  @@map("usage_counters")
}

